<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Content-addressed blob store (spec §11.2). sha256 is the immutable primary key;
         identical bytes dedupe to one row. ref_count tracks live references; a nightly
         sweep (out of scope here) deletes blobs at ref_count = 0 with no retained revision
         referencing them. -->
    <changeSet id="007-media-blobs" author="sf">
        <comment>Content-addressed blob store backing media assets (spec §11.2).</comment>
        <createTable tableName="blob">
            <column name="sha256" type="CHAR(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="size_bytes" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="mime_type" type="VARCHAR(150)"/>
            <column name="storage_key" type="VARCHAR(500)"/>
            <column name="ref_count" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
