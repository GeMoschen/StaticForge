<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- output_channel.settings is a JSON column, declared per-dialect so Hibernate's
         @JdbcTypeCode(SqlTypes.JSON) mapping validates against the actual schema
         (spec §15.2, §22.3). PostgreSQL uses JSONB; H2 uses the native JSON type.
         `key` is a reserved word in H2, so the H2 column is created with an explicit
         quoted `"key"` (lowercase) to match PostgreSQL's unquoted lowercase `key`. -->
    <changeSet id="010-output-channel-postgresql" author="sf" dbms="postgresql">
        <comment>Output channels (spec §15.2) — PostgreSQL (jsonb settings).</comment>
        <createTable tableName="output_channel">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="project_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="key" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="file_extension" type="VARCHAR(10)"/>
            <column name="mime_type" type="VARCHAR(100)"/>
            <column name="default_escaping" type="VARCHAR(20)"/>
            <column name="enabled" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="is_default" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="position" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="settings" type="JSONB"/>
        </createTable>
    </changeSet>

    <changeSet id="010-output-channel-h2" author="sf" dbms="h2">
        <comment>Output channels (spec §15.2) — H2 (json settings; "key" is a reserved word).</comment>
        <sql>
            CREATE TABLE output_channel (
                id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
                project_id BIGINT NOT NULL,
                "key" VARCHAR(40) NOT NULL,
                name VARCHAR(100) NOT NULL,
                file_extension VARCHAR(10),
                mime_type VARCHAR(100),
                default_escaping VARCHAR(20),
                enabled BOOLEAN NOT NULL,
                is_default BOOLEAN NOT NULL,
                position INT NOT NULL,
                settings JSON
            )
        </sql>
    </changeSet>

    <changeSet id="010-output-channel-unique-postgresql" author="sf" dbms="postgresql">
        <addUniqueConstraint tableName="output_channel"
                columnNames="project_id, key"
                constraintName="uq_output_channel_project_key"/>
    </changeSet>

    <changeSet id="010-output-channel-unique-h2" author="sf" dbms="h2">
        <sql>ALTER TABLE output_channel ADD CONSTRAINT uq_output_channel_project_key UNIQUE (project_id, "key")</sql>
    </changeSet>

    <changeSet id="010-output-channel-index" author="sf">
        <createIndex tableName="output_channel" indexName="idx_output_channel_project">
            <column name="project_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
