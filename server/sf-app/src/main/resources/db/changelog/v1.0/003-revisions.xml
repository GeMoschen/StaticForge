<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003-revisions-counter" author="sf">
        <comment>Per-project gapless revision counter (spec §7.3).</comment>
        <createTable tableName="project_revision_counter">
            <column name="project_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false" foreignKeyName="fk_counter_project" references="project(id)"/>
            </column>
            <column name="next_revision" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="003-revisions-revision-postgresql" author="sf" dbms="postgresql">
        <comment>Revision record (spec §7.2) — PostgreSQL (jsonb summary).</comment>
        <createTable tableName="revision">
            <column name="project_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false" foreignKeyName="fk_revision_project" references="project(id)"/>
            </column>
            <column name="revision_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT"/>
            <column name="change_type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="comment" type="VARCHAR(500)"/>
            <column name="summary" type="JSONB">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="003-revisions-revision-h2" author="sf" dbms="h2">
        <comment>Revision record (spec §7.2) — H2 (json summary).</comment>
        <createTable tableName="revision">
            <column name="project_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false" foreignKeyName="fk_revision_project" references="project(id)"/>
            </column>
            <column name="revision_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT"/>
            <column name="change_type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="comment" type="VARCHAR(500)"/>
            <column name="summary" type="JSON">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
