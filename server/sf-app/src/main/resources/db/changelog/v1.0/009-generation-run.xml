<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- generation_run.diagnostics is a JSON column, declared per-dialect so Hibernate's
         @JdbcTypeCode(SqlTypes.JSON) mapping validates against the actual schema
         (spec §18.5, §22.3). PostgreSQL uses JSONB; H2 uses the native JSON type. -->
    <changeSet id="009-generation-run-postgresql" author="sf" dbms="postgresql">
        <comment>Generation run ledger (spec §18.5) — PostgreSQL (jsonb diagnostics).</comment>
        <createTable tableName="generation_run">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="project_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="revision_id" type="BIGINT"/>
            <column name="mode" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="channels" type="VARCHAR(500)"/>
            <column name="target_id" type="BIGINT"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="started_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="finished_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="started_by" type="BIGINT"/>
            <column name="files_written" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="files_skipped" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="bytes_written" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="error_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="warning_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="diagnostics" type="JSONB"/>
            <column name="log_blob_sha" type="VARCHAR(64)"/>
        </createTable>
    </changeSet>

    <changeSet id="009-generation-run-h2" author="sf" dbms="h2">
        <comment>Generation run ledger (spec §18.5) — H2 (json diagnostics).</comment>
        <createTable tableName="generation_run">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="project_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="revision_id" type="BIGINT"/>
            <column name="mode" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="channels" type="VARCHAR(500)"/>
            <column name="target_id" type="BIGINT"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="started_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="finished_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="started_by" type="BIGINT"/>
            <column name="files_written" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="files_skipped" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="bytes_written" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="error_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="warning_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="diagnostics" type="JSON"/>
            <column name="log_blob_sha" type="VARCHAR(64)"/>
        </createTable>
    </changeSet>

    <changeSet id="009-generation-run-index" author="sf">
        <createIndex tableName="generation_run" indexName="idx_generation_run_project">
            <column name="project_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
