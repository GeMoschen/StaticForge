<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- M26.1.1: an account created or reset by an instance admin carries a temporary password; while
         this flag is set every API call except the password-change allowlist answers 428 SF-API-0428.
         The DELETED status needs no DDL: app_user.status is a plain VARCHAR(30) without a CHECK. -->
    <changeSet id="019-app-user-must-change-password" author="sf">
        <addColumn tableName="app_user">
            <column name="must_change_password" type="BOOLEAN" defaultValueBoolean="false" valueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- M26.3.1: the instance audit view filters by action and by actor, newest first
         (idx_audit_log_created from 011 already serves the unfiltered and date-range listing). -->
    <changeSet id="019-audit-log-index-action-created" author="sf">
        <createIndex tableName="audit_log" indexName="idx_audit_log_action_created">
            <column name="action"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="019-audit-log-index-actor-created" author="sf">
        <createIndex tableName="audit_log" indexName="idx_audit_log_actor_created">
            <column name="actor_user_id"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
