<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- generation_target.config is a JSON column, declared per-dialect so Hibernate's
         @JdbcTypeCode(SqlTypes.JSON) mapping validates against the actual schema
         (spec §18.4, §22.3). PostgreSQL uses JSONB; H2 uses the native JSON type. -->
    <changeSet id="008-generation-target-postgresql" author="sf" dbms="postgresql">
        <comment>Generation targets — filesystem/ZIP/S3 output destinations (spec §18.4).</comment>
        <createTable tableName="generation_target">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="project_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="config" type="JSONB"/>
            <column name="is_default" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="008-generation-target-h2" author="sf" dbms="h2">
        <comment>Generation targets — filesystem/ZIP/S3 output destinations (spec §18.4).</comment>
        <createTable tableName="generation_target">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="project_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="config" type="JSON"/>
            <column name="is_default" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="008-generation-target-index" author="sf">
        <createIndex tableName="generation_target" indexName="idx_generation_target_project">
            <column name="project_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
