<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- audit_log is the append-only security trail (§26.3): auth, membership, channel and
         generation-target changes. It is separate from content revisions (§26.3 note). The
         detail column is declared per-dialect (JSONB / JSON) to match Hibernate's
         @JdbcTypeCode(SqlTypes.JSON) mapping, mirroring 008/010. -->
    <changeSet id="011-audit-log-postgresql" author="sf" dbms="postgresql">
        <comment>Audit trail (§26.3) — PostgreSQL (jsonb detail).</comment>
        <createTable tableName="audit_log">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="project_id" type="BIGINT"/>
            <column name="actor_user_id" type="BIGINT"/>
            <column name="action" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="target" type="VARCHAR(255)"/>
            <column name="detail" type="JSONB"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="011-audit-log-h2" author="sf" dbms="h2">
        <comment>Audit trail (§26.3) — H2 (json detail).</comment>
        <sql>
            CREATE TABLE audit_log (
                id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
                project_id BIGINT,
                actor_user_id BIGINT,
                action VARCHAR(64) NOT NULL,
                target VARCHAR(255),
                detail JSON,
                created_at TIMESTAMP WITH TIME ZONE NOT NULL
            )
        </sql>
    </changeSet>

    <changeSet id="011-audit-log-index-project" author="sf">
        <createIndex tableName="audit_log" indexName="idx_audit_log_project">
            <column name="project_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="011-audit-log-index-created" author="sf">
        <createIndex tableName="audit_log" indexName="idx_audit_log_created">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
