<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- URL registry (feature 08-m8-navigation-rewrite/02-url-registry, M8.2.1): a plain CRUD
         cache table, not a revisioned asset — see UrlRegistryEntry's javadoc for why. No JSON
         columns, so no per-dialect split is needed. channel_key and page_reference_uuid are
         unenforced value references (no FK), matching how OutputChannel.key and cross-asset
         UUIDs are already referenced elsewhere in this schema (never a real FK on asset(uuid),
         only ever on asset(id)). -->
    <changeSet id="014-url-registry" author="sf">
        <comment>URL registry cache table (feature url-registry, M8.2.1).</comment>
        <createTable tableName="url_registry_entry">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="project_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="channel_key" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="page_reference_uuid" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="area" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="url" type="VARCHAR(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="assigned_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="assigned_revision" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="overridden" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="url_registry_entry"
                columnNames="project_id, channel_key, page_reference_uuid, area"
                constraintName="uq_url_registry_tuple"/>

        <createIndex tableName="url_registry_entry" indexName="idx_url_registry_project_area">
            <column name="project_id"/>
            <column name="area"/>
        </createIndex>

        <createIndex tableName="url_registry_entry" indexName="idx_url_registry_page_reference">
            <column name="page_reference_uuid"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
