<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- M9.1.1: asset.uuid uniqueness moves from server-wide to per-project
         (feature 09-m9-project-scoped-uuids/01-uuid-scope-schema). Every real lookup already
         resolves a UUID inside a known project (`/projects/{p}/assets/{uuid}`), so nothing
         relies on server-wide uniqueness as a feature — this is a scope loosening, not a new
         invariant.

         002-assets.xml declared `uuid` with an inline `unique="true"` constraint and no
         explicit name, so the DB assigned its own default name; dropUniqueConstraint requires
         a constraintName (neither H2 nor PostgreSQL can drop-by-column-list), so this dbms
         split exists solely to name that vendor-assigned constraint correctly. PostgreSQL's
         default name for an inline single-column UNIQUE constraint is
         `<table>_<column>_key`. H2 assigns an internal sequential name (`CONSTRAINT_<n>`)
         based on schema-object creation order — confirmed as `CONSTRAINT_5` against a fresh
         test schema via `INFORMATION_SCHEMA.TABLE_CONSTRAINTS`, stable for this fixed
         changelog history. If changesets are ever inserted before this one (they shouldn't
         be; changesets are immutable, spec §22.4), re-verify this name. -->
    <changeSet id="015-project-scoped-uuid-drop-postgresql" author="sf" dbms="postgresql">
        <sql>ALTER TABLE asset DROP CONSTRAINT asset_uuid_key;</sql>
        <rollback>
            <addUniqueConstraint tableName="asset" columnNames="uuid" constraintName="asset_uuid_key"/>
        </rollback>
    </changeSet>

    <changeSet id="015-project-scoped-uuid-drop-h2" author="sf" dbms="h2">
        <sql>ALTER TABLE asset DROP CONSTRAINT "CONSTRAINT_5";</sql>
        <rollback>
            <addUniqueConstraint tableName="asset" columnNames="uuid" constraintName="CONSTRAINT_5"/>
        </rollback>
    </changeSet>

    <changeSet id="015-project-scoped-uuid" author="sf">
        <comment>Loosen asset.uuid uniqueness to (project_id, uuid) (feature uuid-scope-schema, M9.1.1).</comment>

        <addUniqueConstraint tableName="asset" columnNames="project_id, uuid"
                             constraintName="uq_asset_project_uuid"/>

        <createIndex tableName="asset" indexName="idx_asset_uuid">
            <column name="uuid"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
