{
  "name": "staticforge-ui",
  "version": "0.0.0",
  "description": "StaticForge CMS frontend shell",
  "private": true,
  "scripts": {
    "start": "ng serve --proxy-config proxy.conf.mjs",
    "build": "ng build",
    "watch": "ng build --watch --output-path dist/staticforge-ui",
    "lint": "npm run lint:i18n && npm run lint:tokens && npm run lint:dialogs && npm run lint:keys",
    "lint:i18n": "node scripts/check-i18n-literals.mjs",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "lint:dialogs": "node scripts/check-window-dialogs.mjs",
    "lint:keys": "node scripts/check-keydown-listeners.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "generate:api": "openapi-typescript ../server/sf-app/build/openapi/openapi.json -o src/app/core/api/generated/schema.d.ts"
  },
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@jsverse/transloco": "7.6.1",
    "@jsverse/transloco-messageformat": "7.0.1",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^1.13.1",
    "@analogjs/vitest-angular": "1.13.1",
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular/cli": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@playwright/test": "^1.47.0",
    "@testing-library/angular": "^17.3.6",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.5.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.4.2",
    "sass": "^1.77.6",
    "typescript": "~5.4.5",
    "vitest": "^2.1.9",
    "zone.js": "^0.14.10"
  }
}
