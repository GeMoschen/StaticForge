# Copy this file to `.env` (same directory) and fill in real values before running
# `docker compose up`. `docker compose` auto-loads `.env` from the compose file directory.

# PostgreSQL credentials. The db service uses these to create the database/role; the
# backend uses them (via DB_*) to connect.
DB_NAME=staticforge
DB_USER=staticforge
DB_PASSWORD=change-me

# Optional backend settings.
# SF_JWT_SECRET=replace-me
# SF_JWT_KEYSTORE=

# Host port that maps to the nginx (web) container's port 80.
WEB_PORT=8080
